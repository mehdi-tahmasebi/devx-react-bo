# API (with demo fixtures in src/data/demo-store.ts)
VITE_USE_DEMO_API=true
VITE_API_BASE_URL=http://localhost:5020

# Optional integrations (geocoding, timezones for building forms)
VITE_TIMEZONE_API_URL=https://timeapi.io/api/TimeZone/AvailableTimeZones
VITE_GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
VITE_PHOTON_GEOCODING_API_URL=https://photon.komoot.io/api/

# Branding (optional — defaults in src/core/branding/)
VITE_APP_TITLE=DevX Backoffice
VITE_APP_DESCRIPTION="Pannello operativo di esempio per il team."
VITE_APP_PRODUCT_LABEL=DEVX BACKOFFICE

# OIDC (optional — leave empty for username/password dev flow)
# VITE_KEYCLOAK_AUTHORITY=https://auth.example.com/realms/sample
# VITE_KEYCLOAK_CLIENT_ID=backoffice
# VITE_KEYCLOAK_SCOPE=openid profile email
